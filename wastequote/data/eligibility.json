{
  "_meta": {
    "table": "eligibility",
    "description": "Which treatment routes are valid for a material at a contamination level. Deterministic: a route is valid only if at least one 'allow' rule matches and no 'deny' rule does (deny wins, default is deny). 'surcharge' and 'warn' rules attach a note; the surcharge amount itself lives in pricing.json. Legal rules cite the law; acceptance rules are the waste company's own (sample) criteria and are marked is_sample.",
    "fields": {
      "material": "a material id, a list of ids, or * for every material",
      "contamination": "the contamination levels the rule applies to",
      "effect": "allow | deny | surcharge | warn"
    }
  },
